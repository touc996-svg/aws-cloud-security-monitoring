{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AEGIS-X Normalized Security Finding",
  "type": "object",
  "required": [
    "finding_id",
    "cloud",
    "provider",
    "severity",
    "title",
    "observed_at"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "cloud": {
      "enum": [
        "aws",
        "azure",
        "gcp"
      ]
    },
    "provider": {
      "type": "string"
    },
    "native_id": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "mitre_techniques": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_payload": {
      "type": "object"
    },
    "finding_type": {
      "type": "string",
      "description": "Provider-native finding type, e.g. Recon:EC2/PortProbeUnprotectedPort"
    },
    "status": {
      "enum": [
        "active",
        "archived",
        "unknown"
      ]
    },
    "first_seen": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "ref"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        }
      }
    },
    "native_severity": {
      "description": "Original provider severity value, unmodified."
    }
  },
  "additionalProperties": true
}
